<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding_gradient"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnKembali"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/kembali"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@android:color/white"
            android:contentDescription="Kembali"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Main Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_section_badge"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_compass"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"
                        app:tint="@android:color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prediksi Sensor"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Input Data Sensor MPU6050"
                    android:textColor="#1e3c72"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <!-- Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Masukkan nilai pembacaan sensor (offline)"
                    android:textColor="#64748b"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <!-- Accelerometer Section -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_section_badge"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@android:drawable/ic_menu_compass"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"
                        app:tint="@android:color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accelerometer"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- AcX Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="AcX :"
                        android:textColor="#1e3c72"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F9FAFB">

                        <EditText
                            android:id="@+id/etAcX"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Isi AcX disini"
                            android:textColorHint="#94a3b8"
                            android:background="@android:color/transparent"
                            android:paddingHorizontal="16dp"
                            android:inputType="numberSigned|numberDecimal"
                            android:textColor="#1e3c72"
                            android:textSize="15sp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- AcY Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="AcY :"
                        android:textColor="#1e3c72"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F9FAFB">

                        <EditText
                            android:id="@+id/etAcY"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Isi AcY disini"
                            android:textColorHint="#94a3b8"
                            android:background="@android:color/transparent"
                            android:paddingHorizontal="16dp"
                            android:inputType="numberSigned|numberDecimal"
                            android:textColor="#1e3c72"
                            android:textSize="15sp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- AcZ Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="AcZ :"
                        android:textColor="#1e3c72"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F9FAFB">

                        <EditText
                            android:id="@+id/etAcZ"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Isi AcZ disini"
                            android:textColorHint="#94a3b8"
                            android:background="@android:color/transparent"
                            android:paddingHorizontal="16dp"
                            android:inputType="numberSigned|numberDecimal"
                            android:textColor="#1e3c72"
                            android:textSize="15sp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Gyroscope Section -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_section_badge"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@android:drawable/ic_menu_rotate"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"
                        app:tint="@android:color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gyroscope"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- GyX Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="GyX :"
                        android:textColor="#1e3c72"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F9FAFB">

                        <EditText
                            android:id="@+id/etGyX"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Isi GyX disini"
                            android:textColorHint="#94a3b8"
                            android:background="@android:color/transparent"
                            android:paddingHorizontal="16dp"
                            android:inputType="numberSigned|numberDecimal"
                            android:textColor="#1e3c72"
                            android:textSize="15sp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- GyY Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="GyY :"
                        android:textColor="#1e3c72"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F9FAFB">

                        <EditText
                            android:id="@+id/etGyY"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Isi GyY disini"
                            android:textColorHint="#94a3b8"
                            android:background="@android:color/transparent"
                            android:paddingHorizontal="16dp"
                            android:inputType="numberSigned|numberDecimal"
                            android:textColor="#1e3c72"
                            android:textSize="15sp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- GyZ Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="GyZ :"
                        android:textColor="#1e3c72"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F9FAFB">

                        <EditText
                            android:id="@+id/etGyZ"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Isi GyZ disini"
                            android:textColorHint="#94a3b8"
                            android:background="@android:color/transparent"
                            android:paddingHorizontal="16dp"
                            android:inputType="numberSigned|numberDecimal"
                            android:textColor="#1e3c72"
                            android:textSize="15sp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Predict Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnPredict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_section_badge"
                        android:padding="16dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_compass"
                            app:tint="@android:color/white"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prediksi Sudut Kemiringan"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Result Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F9FAFB">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hasil Prediksi"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#1e3c72"
                            android:layout_marginBottom="12dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5E7EB"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tvResult"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sudut Kemiringan (Pitch °): -"
                            android:textSize="15sp"
                            android:textColor="#64748b"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Decorative Circle -->
        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@android:color/white"
            android:alpha="0.05"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="-75dp"
            android:layout_marginBottom="-75dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>