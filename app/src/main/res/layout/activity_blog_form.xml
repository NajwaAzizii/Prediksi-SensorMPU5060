<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding_gradient"
    tools:context=".BlogFormActivity">

    <!-- ===== Decorative waves (tema sama seperti onboarding) ===== -->
    <View
        android:id="@+id/decoTopLeft"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="-80dp"
        android:alpha="0.35"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/decoTopRight"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginEnd="-60dp"
        android:layout_marginTop="90dp"
        android:alpha="0.25"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/decoBottomLeft"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginStart="-70dp"
        android:layout_marginBottom="90dp"
        android:alpha="0.22"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <View
        android:id="@+id/decoBottomRight"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="-60dp"
        android:alpha="0.20"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===== HEADER (tetap ada, id sama) ===== -->
    <View
        android:id="@+id/headerBlue"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:alpha="0.20"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Back (id sama) -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_skip_button"
        android:contentDescription="Kembali"
        android:padding="10dp"
        android:src="@drawable/kembali"
        app:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/headerBlue"
        app:layout_constraintBottom_toBottomOf="@id/headerBlue"/>

    <!-- Title (id sama) -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Blog"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:shadowColor="#60000000"
        android:shadowDx="0"
        android:shadowDy="4"
        android:shadowRadius="8"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"/>

    <!-- ===== Bubbles (id lama tetap ada, hanya ganti style biar senada) ===== -->
    <View
        android:id="@+id/bubbleTopLeftBig"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.18"
        android:background="@drawable/bg_wave_decoration"
        android:translationX="-100dp"
        android:translationY="-80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/bubbleTopLeftSmall"
        android:layout_width="200dp"
        android:layout_height="210dp"
        android:alpha="0.12"
        android:background="@drawable/bg_wave_decoration"
        android:translationX="20dp"
        android:translationY="-150dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- ===== CARD FORM (id sama) ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardForm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="-52dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="18dp"
        app:cardUseCompatPadding="true"
        app:strokeWidth="1dp"
        app:strokeColor="#22FFFFFF"
        app:cardBackgroundColor="#F8FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/headerBlue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Judul -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Judul"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#1e3c72"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTitle"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxStrokeColor="#7e22ce"
                    app:boxBackgroundColor="#F9FAFB"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Masukkan Judul Disini"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:textColor="#1e3c72"
                        android:textColorHint="#94a3b8"
                        android:textSize="14sp"
                        android:background="@null"
                        android:includeFontPadding="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp"/>

                <!-- Isi -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Isi"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#1e3c72"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilContent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxStrokeColor="#7e22ce"
                    app:boxBackgroundColor="#F9FAFB"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="Masukkan isi Blog disini"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:textColor="#1e3c72"
                        android:textColorHint="#94a3b8"
                        android:textSize="14sp"
                        android:background="@null"
                        android:includeFontPadding="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp"/>

                <!-- Penulis -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penulis"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#1e3c72"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAuthor"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxStrokeColor="#7e22ce"
                    app:boxBackgroundColor="#F9FAFB"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Masukkan Nama Penulis"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:textColor="#1e3c72"
                        android:textColorHint="#94a3b8"
                        android:textSize="14sp"
                        android:background="@null"
                        android:includeFontPadding="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp"/>

                <!-- Thumbnail -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thumbnail"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#1e3c72"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPickThumb"
                    android:layout_width="match_parent"
                    android:layout_height="118dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#F3F0FF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#C4B5FD"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgThumb"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:src="@android:drawable/ic_menu_gallery"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="#7e22ce" />

                        <TextView
                            android:id="@+id/tvPickInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Klik untuk mengunggah\nJPG, JPEG, PNG (≤ 1MB)"
                            android:textColor="#5b21b6"
                            android:textSize="12sp"
                            android:alpha="0.85"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/imgThumb" />

                        <!-- tombol transparan agar seluruh area bisa diklik (id sama) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickImage"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:backgroundTint="@android:color/transparent"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text=""
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="18dp"/>

                <!-- Simpan (id sama) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Simpan"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#7e22ce"
                    app:cornerRadius="18dp"
                    app:elevation="6dp"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
