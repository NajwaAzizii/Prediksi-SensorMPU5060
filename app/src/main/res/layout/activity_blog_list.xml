<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding_gradient"
    tools:context=".BlogListActivity">

    <!-- ===== Decorative waves (tema onboarding) ===== -->
    <View
        android:id="@+id/bubbleTopLeftBig"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="-80dp"
        android:alpha="0.30"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/bubbleTopLeftSmall"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginEnd="-60dp"
        android:layout_marginTop="90dp"
        android:alpha="0.22"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/bubbleBottomRightBig"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginStart="-70dp"
        android:layout_marginBottom="90dp"
        android:alpha="0.20"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <View
        android:id="@+id/bubbleBottomRightSmall"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="-60dp"
        android:alpha="0.18"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===== HEADER ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Keluar (pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Keluar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#FF5A6B"
            app:cornerRadius="999dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Sorotan -->
        <TextView
            android:id="@+id/tvHighlight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sorotan Hari Ini"
            android:textColor="#EDE9FE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:alpha="0.9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnLogout"/>

        <!-- Blog -->
        <TextView
            android:id="@+id/tvTitlePage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Blog"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:shadowColor="#60000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHighlight"/>

        <!-- Search icon (lingkaran putih) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSearchIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#F8FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHighlight">

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="Cari"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#4C1D95"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tambah (pill hijau modern) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTambah"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:text="Tambah"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#22C55E"
            app:cornerRadius="999dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSearchIcon"/>

        <!-- Barrier header -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierHeaderBottom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvTitlePage,btnTambah"/>

        <!-- Search Bar card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSearchBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardCornerRadius="22dp"
            app:cardElevation="14dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="#F8FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/barrierHeaderBottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSearch"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    app:boxCollapsedPaddingTop="0dp"
                    app:boxBackgroundColor="#F9FAFB"
                    app:boxStrokeColor="#7E22CE"
                    app:boxStrokeWidth="1.5dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:endIconMode="clear_text"
                    app:hintEnabled="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnCloseSearch"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Cari judul / penulis / isi..."
                        android:paddingStart="16dp"
                        android:paddingEnd="56dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:scrollHorizontally="true"
                        android:inputType="textNoSuggestions"
                        android:importantForAutofill="no"
                        android:autofillHints=""
                        android:imeOptions="actionSearch|flagNoPersonalizedLearning"
                        android:textColor="#1E3A8A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:background="@null"/>
                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/btnCloseSearch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Tutup search"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#4C1D95"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBlog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
