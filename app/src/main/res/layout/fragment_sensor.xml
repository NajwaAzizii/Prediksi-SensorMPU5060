<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding_gradient">

    <!-- Modern Decorative Elements -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="-80dp"
        android:layout_marginStart="-80dp" />

    <View
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="-60dp" />

    <View
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="-70dp" />

    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_wave_decoration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-60dp"
        android:layout_marginEnd="50dp" />

    <!-- Modern Skip Button -->
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_skip_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skip"
                android:textColor="@color/putih"
                android:textSize="16sp"
                android:textStyle="bold" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Modern Card Container -->
        <FrameLayout
            android:layout_width="310dp"
            android:layout_height="310dp"
            android:layout_marginBottom="40dp">

            <!-- Outer Glow -->
            <androidx.cardview.widget.CardView
                android:layout_width="290dp"
                android:layout_height="290dp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="36dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#30FFFFFF" />

            <!-- Main Card with modern gradient -->
            <androidx.cardview.widget.CardView
                android:layout_width="290dp"
                android:layout_height="290dp"
                android:layout_gravity="center"
                app:cardCornerRadius="36dp"
                app:cardElevation="20dp"
                app:cardBackgroundColor="@android:color/transparent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_modern">

                    <!-- Inner Circle Background -->
                    <View
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_wave_decoration"
                        android:alpha="0.3" />

                    <ImageView
                        android:id="@+id/gambarSensor"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:src="@drawable/gambar_sensor"
                        android:contentDescription="@string/judul_sensor"
                        android:scaleType="centerInside" />

                </FrameLayout>

            </androidx.cardview.widget.CardView>

        </FrameLayout>

        <!-- Title with modern styling -->
        <TextView
            android:id="@+id/judulSensor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/judul_sensor"
            android:textColor="@color/putih"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textAlignment="center"
            android:shadowColor="#60000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="8"
            android:letterSpacing="0.02" />

        <!-- Description -->
        <TextView
            android:id="@+id/textSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/isi_sensor"
            android:textColor="@color/putih"
            android:textSize="16sp"
            android:textAlignment="center"
            android:lineSpacingExtra="6dp"
            android:paddingHorizontal="20dp"
            android:alpha="0.95"
            android:letterSpacing="0.01" />

    </LinearLayout>

    <!-- Modern Page Indicators -->
    <LinearLayout
        android:id="@+id/dotsIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_inactive" />

        <View
            android:layout_width="40dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_active" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_inactive" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>